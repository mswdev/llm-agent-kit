{
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/post-tool-a11y-check.sh",
            "timeout": 20,
            "statusMessage": "Checking accessibility..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/stop-a11y-check.sh",
            "timeout": 30,
            "statusMessage": "Verifying no accessibility violations remain..."
          }
        ]
      }
    ]
  }
}
